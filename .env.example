# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: MongoDB connection string for production persistence.
# If omitted in local preview, EduGuard falls back to a local file-persisted document store (.data/eduguard.db.json).
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/eduguard"

# JWT Secrets for access and refresh token signing
JWT_SECRET="replace-with-strong-32-byte-secret"
JWT_REFRESH_SECRET="replace-with-strong-32-byte-refresh-secret"

# Super Admin account credentials (seeded / synced on server startup)
ADMIN_EMAIL="admin@eduguard.gov.pk"
ADMIN_PASSWORD="replace-with-strong-admin-password"

